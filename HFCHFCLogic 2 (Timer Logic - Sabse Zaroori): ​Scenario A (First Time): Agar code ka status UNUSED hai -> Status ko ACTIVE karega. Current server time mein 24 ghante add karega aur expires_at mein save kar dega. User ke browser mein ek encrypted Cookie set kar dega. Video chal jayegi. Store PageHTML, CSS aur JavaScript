<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HFC Store - Premium Digital Assets</title>
    <style>
        /* CSS: Premium Dark Theme Design */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #0f0f0f;
            color: #ffffff;
        }
        header {
            background-color: #1a1a1a;
            padding: 20px;
            text-align: center;
            border-bottom: 2px solid #ffd700;
        }
        h1 {
            color: #ffd700;
            font-size: 24px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        /* Tabs Styling */
        .tabs {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
        }
        .tab-btn {
            background-color: #2a2a2a;
            color: #fff;
            border: 1px solid #444;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: 0.3s;
        }
        .tab-btn.active {
            background-color: #ffd700;
            color: #000;
        }
        /* Sections */
        .section {
            display: none;
        }
        .section.active {
            display: block;
            animation: fadeIn 0.5s;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        /* Cards Styling */
        .cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }
        .card {
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            transition: 0.3s;
        }
        .card:hover {
            border-color: #ffd700;
            transform: translateY(-5px);
        }
        .card h3 {
            color: #ffd700;
            margin-bottom: 10px;
        }
        .price {
            font-size: 28px;
            font-weight: bold;
            margin: 15px 0;
        }
        .buy-btn {
            background-color: #ffd700;
            color: #000;
            border: none;
            padding: 10px 20px;
            width: 100%;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
        }
        .buy-btn:hover {
            background-color: #ffea00;
        }
        /* Manage Wallet Section */
        .input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        input[type="text"] {
            flex: 1;
            padding: 12px;
            background-color: #1a1a1a;
            border: 1px solid #444;
            color: #fff;
            border-radius: 5px;
        }
        .action-btn {
            background-color: #00a8ff;
            color: #fff;
            border: none;
            padding: 12px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        /* Payment Modal Styling */
        #paymentModal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background: #1a1a1a;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
            width: 90%;
            max-width: 400px;
            border: 1px solid #ffd700;
        }
        .qr-placeholder {
            width: 200px;
            height: 200px;
            background-color: #333;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #888;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <header>
        <h1>🪙 HFC Store</h1>
        <p>Premium Digital Gaming Coins</p>
    </header>

    <div class="container">
        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('buy')">🛒 Buy HFC Coins</button>
            <button class="tab-btn" onclick="switchTab('manage')">💳 Manage My Wallet</button>
        </div>

        <!-- Section 1: Buy Coins -->
        <div id="buy" class="section active">
            <div class="cards-container">
                <div class="card">
                    <h3>Starter Pack</h3>
                    <p>30 HFC Coins</p>
                    <div class="price">₹29</div>
                    <button class="buy-btn" onclick="openPayment(29, 30)">Buy Now</button>
                </div>
                <div class="card">
                    <h3>Pro Pack</h3>
                    <p>80 HFC Coins</p>
                    <div class="price">₹49</div>
                    <button class="buy-btn" onclick="openPayment(49, 80)">Buy Now</button>
                </div>
                <div class="card">
                    <h3>VIP Pack</h3>
                    <p>200 HFC Coins</p>
                    <div class="price">₹99</div>
                    <button class="buy-btn" onclick="openPayment(99, 200)">Buy Now</button>
                </div>
            </div>
        </div>

        <!-- Section 2: Manage Wallet -->
        <div id="manage" class="section">
            <h2 style="margin-bottom: 15px; color: #ffd700;">Access Your Wallet</h2>
            <div class="input-group">
                <input type="text" id="walletCode" placeholder="Enter your WALLET-XXXX code...">
                <button class="action-btn" onclick="checkWallet()">Access</button>
            </div>
            
            <!-- Hidden Dashboard (Shows after entering code) -->
            <div id="walletDashboard" style="display: none; background: #1a1a1a; padding: 20px; border-radius: 10px; border: 1px solid #333;">
                <h3 style="color: #00e676; margin-bottom: 20px;">🟢 Balance: <span id="coinBalance">0</span> Coins</h3>
                
                <h4 style="margin-bottom: 10px;">Generate Access Pass:</h4>
                <div class="cards-container">
                    <div class="card" style="padding: 15px;">
                        <h4>1-Day Pass</h4>
                        <p style="color: #aaa; margin: 10px 0;">Cost: 1 Coin</p>
                        <button class="buy-btn" onclick="generatePass(1)">Generate</button>
                    </div>
                    <div class="card" style="padding: 15px;">
                        <h4>7-Day Pass</h4>
                        <p style="color: #aaa; margin: 10px 0;">Cost: 7 Coins</p>
                        <button class="buy-btn" onclick="generatePass(7)">Generate</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Modal (Hidden by default) -->
    <div id="paymentModal">
        <div class="modal-content">
            <h2 style="color: #ffd700; margin-bottom: 10px;">Pay via UPI</h2>
            <p>Scan to pay ₹<span id="payAmount"></span> for <span id="payCoins"></span> Coins</p>
            
            <div class="qr-placeholder">
                [ QR Code Image Here ]
            </div>
            
            <p style="margin-bottom: 10px;">UPI ID: admin@paytm</p>
            
            <div class="input-group" style="margin-top: 20px;">
                <input type="text" id="utrNumber" placeholder="Enter 12-Digit UTR Number">
            </div>
            <button class="buy-btn" onclick="submitUTR()">Verify Payment</button>
            <button style="background: transparent; border: none; color: #aaa; margin-top: 15px; cursor: pointer;" onclick="closePayment()">Cancel</button>
        </div>
    </div>

    <script>
        // JS: Basic Logic & Interactions

        // Tab Switching Logic
        function switchTab(tabId) {
            document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.target.classList.add('active');
        }

        // Payment Modal Logic
        function openPayment(price, coins) {
            document.getElementById('payAmount').innerText = price;
            document.getElementById('payCoins').innerText = coins;
            document.getElementById('paymentModal').style.display = 'flex';
        }

        function closePayment() {
            document.getElementById('paymentModal').style.display = 'none';
        }

        function submitUTR() {
            const utr = document.getElementById('utrNumber').value;
            if(utr.length < 12) {
                alert("Please enter a valid 12-digit UTR number!");
                return;
            }
            // Future: Here we will connect Firebase to check UTR via MacroDroid
            alert("Payment Verified! Your Master Wallet Code is: WALLET-X9K2-30C\n\nPlease save this code!");
            closePayment();
        }

        // Wallet Logic
        function checkWallet() {
            const code = document.getElementById('walletCode').value;
            if(code === "") {
                alert("Please enter a wallet code.");
                return;
            }
            // Future: Here Firebase will check if code exists and fetch balance
            document.getElementById('coinBalance').innerText = "30";
            document.getElementById('walletDashboard').style.display = "block";
        }

        function generatePass(cost) {
            // Future: Firebase will deduct balance and return Pass Code
            alert("Success! 1 Coin deducted. \n\nYour Access Code is: PASS-1D-A8B9\n\nUse this on the main site.");
        }
    </script>
</body>
</html>
